{
  "functions": {
    "api/index.py": {
      "includeFiles": "{*.py,*.json,static/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/index.html",
      "destination": "/static/index.html"
    },
    {
      "source": "/",
      "destination": "/static/index.html"
    }
  ]
}
